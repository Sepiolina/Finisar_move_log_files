{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Log Archiver",
  "version": "0.1.0",
  "identifier": "com.log-archiver.app",
  "build": { "frontendDist": "frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Log Archiver", "width": 1120, "height": 760, "minWidth": 760, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
